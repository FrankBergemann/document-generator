# Byte-compiled / optimized
__pycache__/
*.py[codz]
*$py.class

# Distribution / packaging
build/
*.egg-info/
*.egg

# Generated CVs (the default --out directory)
dist/

# Environments
.venv/
venv/
env/
.env
