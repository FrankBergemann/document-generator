# the browser image and the pip client and therefore belongs in the repo.
!/.devcontainer/.env

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Editors
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
