{
  "sections": [
    {
      "source": "Rechnung-head.docx",
      "format": "docx"
    },
    {
      "source": "Rechnungsbeträge.xlsx",
      "format": "xlsx",
      "col-start": "C",
      "col-end": "G",
      "row-start": 3,
      "row-end": 10,
      "noframes": false
    },
    {
      "source": "Rechnung-tail.docx",
      "format": "docx"
    }
  ],
    "postprocessing": [
    {
      "set-invoice-amount": true,
      "pattern": "Rechnungsbetrag von 0.000,00 € Euro zu stellen",
      "old": "0.000,00 €",
      "new": "${amount-from-invoice-table}",
      "cell": "Gesamtbetrag"
    }
  ],
  "target": "dist/rechnung"
}
